{
  "id": "squad_dglab",
  "name": "SQUAD DG-LAB",
  "version": "1.0.0",
  "sdk": "1",
  "author": "wanchudao",
  "description": "YOLO 视觉检测触发 — SQUAD 游戏击杀/倒地/压制事件实时体感反馈",
  "homepage": "https://github.com/wanchudao/SQUAD_DGLAB/tree/dghub-plugin",
  "entry": "start.bat",
  "config_schema": [
    {
      "section": "触发强度",
      "fields": [
        {
          "key": "bleeding_delta_pct",
          "type": "percent",
          "label": "流血 delta%",
          "default": 15,
          "description": "玩家掉血时触发"
        },
        {
          "key": "incap_delta_pct",
          "type": "percent",
          "label": "倒地 delta%",
          "default": 30,
          "description": "玩家倒地时触发"
        },
        {
          "key": "death_delta_pct",
          "type": "percent",
          "label": "死亡 delta%",
          "default": 50,
          "description": "玩家阵亡时触发"
        },
        {
          "key": "suppression_light_delta_pct",
          "type": "percent",
          "label": "轻度压制 delta%",
          "default": 10,
          "description": "附近轻度火力压制"
        },
        {
          "key": "suppression_heavy_delta_pct",
          "type": "percent",
          "label": "重度压制 delta%",
          "default": 20,
          "description": "附近重度火力压制"
        }
      ]
    },
    {
      "section": "触发时长",
      "fields": [
        {
          "key": "bleeding_duration_s",
          "type": "duration",
          "label": "流血时长 (秒)",
          "default": 2.0,
          "min": 0.1,
          "max": 30.0
        },
        {
          "key": "incap_duration_s",
          "type": "duration",
          "label": "倒地时长 (秒)",
          "default": 4.0,
          "min": 0.1,
          "max": 30.0
        },
        {
          "key": "death_duration_s",
          "type": "duration",
          "label": "死亡时长 (秒)",
          "default": 5.0,
          "min": 0.1,
          "max": 30.0
        },
        {
          "key": "suppression_light_duration_s",
          "type": "duration",
          "label": "轻度压制时长 (秒)",
          "default": 1.5,
          "min": 0.1,
          "max": 30.0
        },
        {
          "key": "suppression_heavy_duration_s",
          "type": "duration",
          "label": "重度压制时长 (秒)",
          "default": 2.0,
          "min": 0.1,
          "max": 30.0
        }
      ]
    },
    {
      "section": "输出设置",
      "fields": [
        {
          "key": "channel",
          "type": "channel",
          "label": "输出通道",
          "default": "both"
        },
        {
          "key": "preset",
          "type": "preset",
          "label": "波形预设",
          "default": "",
          "description": "DG-LAB 波形预设（为空时仅调强度不播波形）"
        }
      ]
    },
    {
      "section": "检测设置",
      "fields": [
        {
          "key": "suppression_mode",
          "type": "select",
          "label": "压制检测模式",
          "default": "off",
          "options": [
            {"label": "关闭", "value": "off"},
            {"label": "模糊检测 (v1)", "value": "blur"},
            {"label": "暗角检测 (v2)", "value": "vignette"}
          ],
          "description": "视觉压制检测，修改后自动重启检测线程"
        },
        {
          "key": "conf_threshold",
          "type": "number",
          "label": "YOLO 置信度阈值",
          "default": 0.6,
          "min": 0.1,
          "max": 1.0,
          "step": 0.05,
          "description": "低于此值的检测结果将被忽略"
        },
        {
          "key": "frame_interval",
          "type": "number",
          "label": "检测间隔 (秒)",
          "default": 0.50,
          "min": 0.1,
          "max": 5.0,
          "step": 0.05,
          "description": "两次 YOLO 检测之间的间隔"
        },
        {
          "key": "show_preview",
          "type": "bool",
          "label": "显示预览窗口",
          "default": false,
          "description": "OpenCV 实时检测预览窗口"
        }
      ]
    }
  ]
}
